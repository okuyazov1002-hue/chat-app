(function(){
window.upmoCal=function(el){
if(el===null){return;}
var now=new Date();
var yr=(window.upmoPeriod&&window.upmoPeriod.y)||now.getFullYear();
function fire(){try{window.dispatchEvent(new CustomEvent('upmo-period',{detail:window.upmoPeriod}));}catch(er){}}
function draw(){
var p=window.upmoPeriod||null;
var h='<div style="display:flex;flex-direction:column;height:100%;padding:10px 12px;box-sizing:border-box;">';
h+='<div style="display:flex;align-items:center;gap:4px;margin-bottom:8px;"><span data-a="prev" style="cursor:pointer;color:#6b7280;font-size:15px;padding:0 3px;user-select:none;">&#8249;</span><span style="font-size:13px;font-weight:700;color:#1f2937;">'+yr+'</span><span data-a="next" style="cursor:pointer;color:#6b7280;font-size:15px;padding:0 3px;user-select:none;">&#8250;</span><span data-a="clr" style="margin-left:auto;cursor:pointer;font-size:17px;line-height:1;color:'+(p?'#e53e3e':'#cbd5e1')+';padding:0 2px;user-select:none;">&times;</span></div>';
h+='<div style="flex:1;min-height:0;display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(3,1fr);gap:6px;">';
for(var m=1;m<=12;m++){
var on=(p!==null&&p.y===yr&&p.m===m);
var cur=(yr===now.getFullYear()&&m===now.getMonth()+1);
h+='<div data-m="'+m+'" style="display:flex;align-items:center;justify-content:center;border-radius:10px;cursor:pointer;font-size:12px;font-weight:700;user-select:none;'+(on?'background:linear-gradient(135deg,#6a5ae0,#1dd3b0);color:#fff;':'background:#f3f4f6;color:#374151;')+((cur&&!on)?'box-shadow:inset 0 0 0 1.5px #4a90d9;':'')+'">'+m+'</div>';
}
h+='</div></div>';
el.innerHTML=h;
}
el.onclick=function(e){
var t=e.target.closest('[data-a],[data-m]');
if(t===null){return;}
var a=t.getAttribute('data-a');
var m=t.getAttribute('data-m');
if(a==='prev'){yr--;}
else if(a==='next'){yr++;}
else if(a==='clr'){window.upmoPeriod=null;fire();}
else if(m){
m=parseInt(m,10);
var p=window.upmoPeriod||null;
if(p!==null&&p.y===yr&&p.m===m){window.upmoPeriod=null;}else{window.upmoPeriod={y:yr,m:m};}
fire();
}
draw();
};
draw();
};
})();
