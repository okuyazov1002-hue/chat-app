(function(){
window.upmoProjPage=function(B,k,ttl){
var lab='font-size:11px;color:#4b5563;font-weight:600;';
var val='font-size:12px;white-space:nowrap;color:#1f2937;font-weight:700;';
var bx='border-radius:14px;padding:8px 6px;box-shadow:0 2px 8px rgba(0,0,0,0.12);';
function cell(t,f){return '<div style="margin-bottom:4px;"><div style="'+lab+'">'+t+'</div><div data-f="'+f+'" style="'+val+'">—</div></div>';}
B.innerHTML='<div style="padding:16px;"><div style="font-size:15px;font-weight:700;color:#1f2937;margin-bottom:16px;">'+ttl+'</div><div style="display:flex;gap:16px;align-items:stretch;"><div id="upmoPCard" style="position:relative;z-index:20;width:315px;box-sizing:border-box;box-shadow:-5px -5px 16px rgba(106,90,224,0.45),5px 5px 16px rgba(29,211,176,0.45),0 0 18px rgba(74,144,217,0.4);border-radius:16px;padding:14px 12px;background:linear-gradient(90deg,#6a5ae0 0%,#4a90d9 50%,#1dd3b0 100%);color:#fff;font-size:11px;"><div style="font-size:11px;color:rgba(255,255,255,0.85);font-weight:700;">Общая стоимость</div><div data-f="tc" style="font-size:18px;color:#fff;font-weight:700;margin-top:2px;">—</div><div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:10px;"><div style="'+bx+'background:rgba(255,255,255,0.5);">'+cell('План','pl')+cell('Остаток','rp')+'</div><div style="'+bx+'background:rgba(255,255,255,0.5);">'+cell('Выполнено','dn')+cell('Остаток','rd')+'</div><div style="'+bx+'background:rgba(255,255,255,0.5);">'+cell('Оплачено','pd')+cell('Остаток','rm')+'</div></div></div><div id="upmoPSt" style="display:flex;gap:0;align-items:stretch;flex:1;min-width:0;margin-left:-30px;"></div></div></div>';
fetch('/api/proj/summary?code='+encodeURIComponent(k.slice(5))).then(function(r){return r.json();}).then(function(d){
var fm=(typeof fmtMoney==='function')?fmtMoney:function(x){return String(x);};
var q=B.querySelector('#upmoPCard');if(!q){return;}
function sv(f,v){var e=q.querySelector('[data-f="'+f+'"]');if(e){e.textContent=fm(Math.round(v||0));}}
sv('tc',d.totalCost);sv('pl',d.plan);sv('rp',Math.max(0,(d.totalCost||0)-(d.plan||0)));sv('dn',d.done);sv('rd',Math.max(0,(d.totalCost||0)-(d.done||0)));sv('pd',d.paid);sv('rm',d.remaining);
}).catch(function(){});
(function(){var box=B.querySelector('#upmoPSt');if(!box){return;}
var ORD=['Базовое проектирование','Детальное проектирование','Изготовление','Логистика','Строительство','ПНР'];
box.innerHTML=ORD.map(function(n,i){return '<div style="box-sizing:border-box;flex:1 1 0;min-width:0;background:#fff;border-radius:0 14px 14px 0;padding:10px 12px 10px 42px;position:relative;z-index:'+(10-i)+';'+(i>0?'margin-left:-30px;':'')+'box-shadow:0 2px 14px rgba(0,0,0,0.2);"><div style="font-size:10px;font-weight:700;color:#1f2937;">'+n+'</div><div data-st="'+n+'" style="font-size:12px;font-weight:700;color:#1f2937;margin-top:6px;white-space:nowrap;">—</div></div>';}).join('');
fetch("/api/reports/"+encodeURIComponent(k.slice(5))+"/summary").then(function(r){return r.json();}).then(function(d){
var fm=(typeof fmtMoney==='function')?fmtMoney:function(x){return String(x);};
ORD.forEach(function(n){var f=null;(d.stages||[]).forEach(function(x){if(x.name===n||(n==='Строительство'&&/строительств|смр/i.test(x.name))||(n==='ПНР'&&/пнр|пуско/i.test(x.name))){f=x;}});
var e=box.querySelector('[data-st="'+n+'"]');if(e){var c=Math.round(f?(f.cost||0):0),dn=Math.round(f?(f.done||0):0),pd=Math.round(f?(f.paid||0):0),pl=Math.round(c*(f?(f.planPct||0):0)/100);
function mn(l,v,bg){var L='font-size:9px;color:#6b7280;font-weight:600;',V='font-size:10px;color:#1f2937;font-weight:700;';return '<div style="background:'+bg+';border-radius:10px;padding:5px 6px;min-width:0;"><div style="'+L+'">'+l+'</div><div style="'+V+'">'+fm(v)+'</div><div style="'+L+'margin-top:3px;">Остаток</div><div style="'+V+'">'+fm(Math.max(0,c-v))+'</div></div>';}
e.innerHTML=fm(c)+'<div style="display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:5px;">'+mn('Выполнено',dn,'rgba(74,144,217,0.2)')+mn('Оплачено',pd,'rgba(29,211,176,0.22)')+'</div>';
var pp=Math.round(f?(f.planPct||0):0),fp=c?Math.min(100,Math.round(dn/c*100)):0,dl=fp-pp;
e.innerHTML+='<div style="display:flex;justify-content:space-between;font-size:10px;font-weight:700;margin-top:10px;"><span style="color:#4a90d9;">'+pp+'%</span><span style="color:'+(dl<0?'#d9776f':'#3aa88a')+';">'+(dl>0?'+':'')+dl+'%</span><span style="color:#2f855a;">'+fp+'%</span></div><div style="height:6px;border-radius:3px;background:#eef0f4;display:flex;overflow:hidden;margin-top:3px;"><div style="width:'+fp+'%;background:#1dd3b0;"></div><div style="width:'+Math.max(0,pp-fp)+'%;background:#4a90d9;"></div></div>';}});
}).catch(function(){});})();
};
var ov=null,A=null,B=null,busy=false;
var st=document.createElement('style');
st.textContent='.upm-win{position:fixed;z-index:2000;top:16px;bottom:16px;background:#fff;border-radius:0 20px 20px 0;box-sizing:border-box;border:1px solid rgba(0,0,0,0.06);transform:translateX(-100%);clip-path:inset(0 0 0 100%);transition:transform .45s cubic-bezier(.22,1,.36,1),clip-path .45s cubic-bezier(.22,1,.36,1);will-change:transform;overflow:auto;}.upm-win.on{transform:translateX(0);clip-path:inset(0 0 0 0);}#upmoA{left:104px;width:420px;padding:16px;z-index:2001;}#upmoB{left:104px;right:16px;bottom:auto;max-height:calc(100vh - 32px);}#upmoWin,#upmoWin *{-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;outline:none;}';
document.head.appendChild(st);
function row(l,k,t,hk){return '<div class="ml-row" data-k="'+k+'" style="display:flex;align-items:center;padding:9px 10px 9px 12px;cursor:pointer;text-align:left;font-size:11px;'+(l?'color:#374151;':'font-weight:700;color:#1f2937;')+'"><span class="ar" style="width:12px;min-width:12px;flex-shrink:0;color:#6b7280;">'+(hk?'&#9662;':'')+'</span><span>'+t+'</span></div>';}
function sec(k,t,items){var inn='';items.forEach(function(it){inn+=row(1,it[0],it[1],false);});return '<div class="ml-card0" style="margin:0 0 6px 0;">'+row(0,k,t,true)+'<div data-kids="'+k+'" data-o="1" style="max-height:600px;overflow:hidden;transition:max-height .35s ease;">'+inn+'</div></div>';}
function listHtml(){
var pi=[['act:all','Общая информация'],['act:int','Внутренний'],['act:ext','Внешний']];
var mi=[],ai=[];
try{mi=PROJECTS.main.items.map(function(it){return ['proj:'+it.code,it.code+' '+it.name];});ai=PROJECTS.aux.items.map(function(it){return ['proj:'+it.code,it.code+' '+it.name];});}catch(err){}
return sec('prep','Подготовительные работы',pi)+sec('main','Основные проекты',mi)+sec('aux','Вспомогательные проекты',ai);
}
function openAll(){
if(ov){return;}
if(Date.now()-(window._upmoLastClose||0)<560){return;}
var _t0=tw;closeTeam();if(_t0){_t0.style.display='none';}ov=document.createElement('div');ov.id='upmoWin';
A=document.createElement('div');A.id='upmoA';A.className='upm-win';A.innerHTML=listHtml();
B=document.createElement('div');B.id='upmoB';B.className='upm-win';
ov.appendChild(A);ov.appendChild(B);document.body.appendChild(ov);
var pv=document.querySelector('.buttons button.nav-active');window._upmoPrev=(pv&&pv.id!=='upmoBtn')?pv:null;document.querySelectorAll('.buttons button').forEach(function(x){x.classList.remove('nav-active');});var b=document.getElementById('upmoBtn');if(b){b.classList.add('nav-active');}
A.addEventListener('click',function(e){
var r=e.target.closest('.ml-row');if(r===null){return;}
var k=r.getAttribute('data-k');
var kids=A.querySelector('[data-kids="'+k+'"]');
if(kids){var op=kids.getAttribute('data-o')==='1';kids.style.maxHeight=op?'0px':kids.scrollHeight+'px';kids.setAttribute('data-o',op?'0':'1');r.querySelector('.ar').innerHTML=op?'&#9656;':'&#9662;';return;}
if(k.indexOf('act:')===0||k.indexOf('proj:')===0){pick(k);}
});
void A.offsetWidth;
setTimeout(function(){if(A){A.classList.add('on');}},20);
}
function closeAll(){
if(ov===null){return;}
window._upmoLastClose=Date.now();
var o=ov,a=A,b=B;ov=null;A=null;B=null;busy=false;
a.classList.remove('on');b.classList.remove('on');
var bt=document.getElementById('upmoBtn');if(bt){bt.classList.remove('nav-active');}if(window._upmoPrev){window._upmoPrev.classList.add('nav-active');window._upmoPrev=null;}
setTimeout(function(){o.remove();if(ov===null&&window.upmoMapRestore){window.upmoMapRestore();}},520);
}
function pick(k){
if(busy){return;}busy=true;
var ttl='';try{ttl=A.querySelector('[data-k="'+k+'"] span:last-child').textContent;}catch(e){}
A.classList.remove('on');B.classList.remove('on');
setTimeout(function(){
if(B===null){busy=false;return;}
if(k.indexOf('proj:')===0){B.style.bottom='16px';window.upmoProjPage(B,k,ttl);}else if(window.upmoFillPanel){B.style.bottom='';window.upmoFillPanel(B,k);}
B.classList.add('on');busy=false;
},480);
}
function teamBdHtml(){
var cards='';
try{
var today=new Date();today.setHours(0,0,0,0);
var arr=PERSONNEL.filter(function(u){return u.birthday;}).map(function(u){var p=u.birthday.split('.');if(p.length!==3){return null;}var d=parseInt(p[0],10),m=parseInt(p[1],10)-1;var n=new Date(today.getFullYear(),m,d);if(n<today){n=new Date(today.getFullYear()+1,m,d);}return {name:u.name,bd:u.birthday,days:Math.round((n-today)/86400000),avatar:u.avatar||''};}).filter(Boolean);
arr.sort(function(a,b){return a.days-b.days;});
cards=arr.slice(0,3).map(function(u){var av=u.avatar?'<img src="'+u.avatar+'">':'<span>'+u.name.charAt(0)+'</span>';return '<div class="bday-card" style="width:auto;margin-left:36px;padding:0 12px 0 36px;height:36px;"><div class="bday-card-avatar" style="width:40px;height:40px;font-size:16px;">'+av+'</div><div class="bday-card-info" style="display:flex;align-items:center;gap:10px;"><div class="bday-card-name" style="margin-bottom:0;flex:1;">'+u.name+'</div><div class="bday-card-date" style="white-space:nowrap;width:68px;text-align:left;flex:0 0 68px;">'+u.bd+'</div><div class="bday-card-days" style="margin-top:0;white-space:nowrap;width:78px;text-align:left;flex:0 0 78px;">'+fmtDaysUntil(u.days)+'</div></div></div>';}).join('');
}catch(e){}
return '<div id="teamBd" style="position:relative;padding:14px 16px 16px 0;background:linear-gradient(135deg,#6A5BD6 0%,#5B94D0 60%,#5FD2B0 100%);box-sizing:border-box;"><div style="margin:0 0 0 16px;font-size:10px;font-weight:700;color:#fff;">День рождения</div><div id="teamBdBody" style="overflow:hidden;transition:max-height .4s cubic-bezier(.22,1,.36,1);"><div style="display:flex;flex-direction:column;gap:10px;padding-top:10px;">'+cards+'</div></div><div id="teamBdHandle" title="Свернуть / развернуть" onclick="var b=document.getElementById(\'teamBdBody\');var o=b.getAttribute(\'data-o\')!==\'0\';b.style.maxHeight=b.scrollHeight+\'px\';void b.offsetHeight;b.style.maxHeight=o?\'0px\':b.scrollHeight+\'px\';b.setAttribute(\'data-o\',o?\'0\':\'1\');this.firstChild.style.transform=o?\'rotate(180deg)\':\'none\';" style="position:absolute;left:50%;bottom:-8px;transform:translateX(-50%);width:48px;height:16px;border-radius:12px;z-index:2;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 8px rgba(0,0,0,0.15);"><svg width="12" height="12" viewBox="0 0 12 12" style="transition:transform .3s;transform:rotate(0deg);"><path d="M2 7 L6 3 L10 7" fill="none" stroke="#5B94D0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div></div>';
}
function teamListHtml(){
var out='';
try{
function rk(u){var pos=String(u.position||'').toLowerCase().trim();var dep=String(u.department||'').toLowerCase();
if(pos.indexOf('заместитель директора')>=0&&pos.indexOf('управлению проектами')>=0){return 2;}
if(pos.indexOf('директор')===0&&pos.indexOf('заместитель')<0){return 1;}
if(pos==='главный инженер'||pos.indexOf('главный инженер дсомк')>=0){return 3;}
if(dep.indexOf('технологический')>=0&&pos.indexOf('начальник отдела')>=0){return 4;}
return 99;}
function det(u){function L(t,v){return v?'<div style="display:flex;justify-content:flex-start;gap:12px;padding:3px 0;"><span style="color:#8a94a6;width:96px;flex:0 0 96px;text-align:right;">'+t+'</span><span style="color:#1f2937;font-weight:600;word-break:break-word;text-align:left;">'+v+'</span></div>':'';}
return '<div style="position:relative;z-index:1;max-height:0;overflow:hidden;opacity:0;margin:0 0 0 36px;background:#fff;border-radius:0 0 10px 10px;padding:0 14px;transition:max-height .35s ease,opacity .3s ease,margin .35s ease,padding .35s ease;font-size:11px;box-shadow:0 4px 10px rgba(0,0,0,0.1);">'+L('Отдел',u.department)+L('Должность',u.position)+L('День рождения',u.birthday)+L('Внутр. телефон',u.internalPhone)+L('Моб. телефон',u.mobilePhone)+L('Email',u.email)+'</div>';}
var us=PERSONNEL.map(function(u,i){return {u:u,i:i,r:rk(u)};}).sort(function(a,b){return a.r-b.r||a.i-b.i;}).map(function(x){return x.u;});
out=us.map(function(u){var av=u.avatar?'<img src="'+u.avatar+'" style="width:100%;height:100%;object-fit:cover;">':'<span>'+(u.name?u.name.charAt(0):'?')+'</span>';
return '<div data-s="'+String([u.name,u.position,u.department].join(' ')).toLowerCase().replace(/"/g,'')+'" style="flex:0 0 auto;"><div onclick="var d=this.nextSibling,o=d.style.maxHeight&&d.style.maxHeight!==\'0px\';d.style.maxHeight=o?\'0px\':(d.scrollHeight+30)+\'px\';d.style.opacity=o?0:1;d.style.marginTop=o?\'0\':\'4px\';d.style.padding=o?\'0 14px\':\'14px 14px 10px\';" style="cursor:pointer;position:relative;z-index:2;display:flex;align-items:center;background:#fff;border-radius:10px;height:44px;margin-left:36px;padding:0 12px 0 36px;box-shadow:0 2px 8px rgba(0,0,0,0.12);box-sizing:border-box;flex:0 0 auto;"><div style="position:absolute;left:-20px;top:50%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;overflow:hidden;background:#4a9fd8;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;box-sizing:border-box;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,0.15);">'+av+'</div><div style="font-size:12px;font-weight:700;color:#1f2937;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">'+u.name+'</div></div>'+det(u)+'</div>';}).join('');
}catch(e){}
return '<div style="padding:22px 16px 16px 0;display:flex;flex-direction:column;gap:10px;">'+out+'</div>';
}
(function(){var st=document.createElement('style');st.textContent='#teamWin{scrollbar-width:none;-ms-overflow-style:none;}#teamWin::-webkit-scrollbar{display:none;width:0;height:0;}';document.head.appendChild(st);})();var tw=null;
var STRUCT_DEFS='<svg width="0" height="0" style="position:absolute"><defs><linearGradient id="impTray" gradientUnits="userSpaceOnUse" x1="18" y1="0" x2="102" y2="0"><stop offset="0" stop-color="#6A5BD6"/><stop offset="0.5" stop-color="#5B94D0"/><stop offset="1" stop-color="#5FD2B0"/></linearGradient><linearGradient id="impArrow" gradientUnits="userSpaceOnUse" x1="0" y1="18" x2="0" y2="72"><stop offset="0" stop-color="#6A5BD6"/><stop offset="1" stop-color="#5B94D0"/></linearGradient><linearGradient id="expArrow" gradientUnits="userSpaceOnUse" x1="0" y1="20" x2="0" y2="72"><stop offset="0" stop-color="#5FD2B0"/><stop offset="1" stop-color="#5B94D0"/></linearGradient></defs></svg>';
function structBtns(code){
var tray='<path d="M20 72 V92 Q20 100 28 100 H92 Q100 100 100 92 V72" fill="none" stroke="url(#impTray)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>';
var imp='<svg width="20" height="20" viewBox="0 0 120 120">'+tray+'<path d="M60 18 V70 M44 54 L60 70 L76 54" fill="none" stroke="url(#impArrow)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/></svg>';
var exp='<svg width="20" height="20" viewBox="0 0 120 120">'+tray+'<path d="M60 72 V20 M44 36 L60 20 L76 36" fill="none" stroke="url(#expArrow)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/></svg>';
return '<span style="margin-left:auto;display:flex;gap:10px;align-items:center;padding-left:10px;"><span data-upd="'+code+'" style="font-size:10px;color:#8a94a6;white-space:nowrap;margin-right:4px;"></span><span class="sx-btn" data-act="import" data-code="'+code+'" title="Импорт" style="display:flex;cursor:pointer;">'+imp+'</span><span class="sx-btn" data-act="export" data-code="'+code+'" title="Экспорт" style="display:flex;cursor:pointer;">'+exp+'</span></span>';
}
function structRow(pad,t,hk,k,bold,open,ex){return '<div class="sx-row" data-sk="'+k+'" style="display:flex;align-items:center;padding:9px 10px 9px '+pad+'px;cursor:pointer;text-align:left;font-size:11px;'+(bold?'font-weight:700;color:#1f2937;':'color:#374151;')+'"><span style="width:12px;min-width:12px;flex-shrink:0;color:#6b7280;transition:transform .3s;'+((hk&&!open)?'transform:rotate(-90deg);':'')+'">'+(hk?'&#9662;':'')+'</span><span>'+t+'</span>'+(ex||'')+'</div>';}
function structKids(k,inner,open){return '<div data-sk-kids="'+k+'" style="overflow:hidden;transition:max-height .35s ease;max-height:'+(open?'5000px':'0')+';">'+inner+'</div>';}
function structListHtml(){
var nm={};try{PROJECTS.main.items.concat(PROJECTS.aux.items).forEach(function(it){nm[it.code]=it.name;});}catch(e){}
var g={},ord=[];try{PROJECTS.prep.items.forEach(function(it){var pc=it.code.split('-')[0];if(g[pc]==null){g[pc]=[];ord.push(pc);}g[pc].push(it);});}catch(e){}
var inner='';
ord.forEach(function(pc){var sub='';g[pc].forEach(function(it){sub+=structRow(12,it.code+' '+it.name,false,'o:'+it.code,false,true,structBtns(it.code));});inner+='<div style="background:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,0.12);margin:4px 10px 10px 10px;">'+structRow(12,(pc+' '+(nm[pc]||'')).trim(),true,'p:'+pc,false,false)+structKids('p:'+pc,sub,false)+'</div>';});
var h='<div class="ml-card0" style="margin:0 0 6px 0;">'+structRow(12,'Подготовительные работы',true,'prep',true,true)+structKids('prep',inner,true)+'</div>';
[['main','Основные проекты'],['aux','Вспомогательные проекты']].forEach(function(x){var it2='';try{PROJECTS[x[0]].items.forEach(function(it){it2+=structRow(14,it.code+' '+it.name,false,'q:'+it.code,false,true);});}catch(e){}h+='<div class="ml-card0" style="margin:0 0 6px 0;">'+structRow(12,x[1],true,x[0],true,true)+structKids(x[0],it2,true)+'</div>';});
return h;
}
window._structCache=window._structCache||null;
function structPaint(w,l){l.forEach(function(x){var e=w.querySelector('[data-upd="'+x.code+'"]');if(!e){return;}if(!x.updatedAt){e.textContent='';return;}var d=new Date(x.updatedAt);if(isNaN(d)){return;}var p2=function(n){return (n<10?'0':'')+n;};e.textContent=(x.updatedBy||'')+' · '+p2(d.getDate())+'.'+p2(d.getMonth()+1)+'.'+d.getFullYear()+' '+p2(d.getHours())+':'+p2(d.getMinutes());});}
function structUpd(w,force){
if(window._structCache&&!force){structPaint(w,window._structCache);return;}
var codes=[];try{PROJECTS.prep.items.forEach(function(it){codes.push(it.code);});}catch(e){}
if(!codes.length){return;}
fetch('/api/reports/list?codes='+encodeURIComponent(codes.join(','))).then(function(r){return r.json();}).then(function(l){
if(!Array.isArray(l)){return;}
window._structCache=l;structPaint(w,l);return;
l.forEach(function(x){var e=w.querySelector('[data-upd="'+x.code+'"]');if(!e){return;}
if(!x.updatedAt){e.textContent='';return;}
var d=new Date(x.updatedAt);if(isNaN(d)){return;}
var p2=function(n){return (n<10?'0':'')+n;};
e.textContent=(x.updatedBy||'')+' · '+p2(d.getDate())+'.'+p2(d.getMonth()+1)+'.'+d.getFullYear()+' '+p2(d.getHours())+':'+p2(d.getMinutes());
});
}).catch(function(){});
}
function structAct(act,code){
if(act==='export'){window.location.href='/api/reports/export?code='+encodeURIComponent(code);return;}
var inp=document.createElement('input');inp.type='file';inp.accept='.xlsx';
inp.onchange=function(){var f=inp.files[0];if(!f){return;}
if(!confirm('Загрузить файл '+f.name+'? Данные запишутся по кодам проектов, указанным внутри файла, и заменят текущие.')){return;}
var fd=new FormData();fd.append('file',f);
fetch('/api/reports/import',{method:'POST',body:fd}).then(function(r){return r.json().catch(function(){return {};}).then(function(j){if(r.ok&&sw){structUpd(sw,true);}alert(r.ok?('Загружено'+(j.message?': '+j.message:'')):('Ошибка: '+(j.message||r.status)));});}).catch(function(){alert('Нет связи с сервером');});
};
inp.click();
}
function structBind(w){w.addEventListener('click',function(e){var bt=e.target.closest('.sx-btn');if(bt){e.stopPropagation();structAct(bt.getAttribute('data-act'),bt.getAttribute('data-code'));return;}var r=e.target.closest('.sx-row');if(!r){return;}var k=r.getAttribute('data-sk');var kd=w.querySelector('[data-sk-kids="'+k+'"]');if(!kd){return;}var ar=r.firstChild;var o=kd.style.maxHeight!=='0px';kd.style.transition='max-height .35s ease';if(o){kd.style.transition='none';kd.style.maxHeight=kd.scrollHeight+'px';void kd.offsetHeight;kd.style.transition='max-height .35s ease';kd.style.maxHeight='0px';}else{kd.style.maxHeight=kd.scrollHeight+'px';setTimeout(function(){if(kd.style.maxHeight!=='0px'){kd.style.maxHeight='5000px';}},420);}if(ar){ar.style.transform=o?'rotate(-90deg)':'';}});}
(function(){var st=document.createElement('style');st.textContent='#structWin{scrollbar-width:none;-ms-overflow-style:none;}#structWin::-webkit-scrollbar{display:none;width:0;height:0;}';document.head.appendChild(st);})();var sw=null;
function closeStruct(instant){
if(sw===null){return;}
var o=sw;sw=null;
if(instant){o.style.display='none';}
o.classList.remove('on');
var sb=document.getElementById('structureBtn');if(sb){sb.classList.remove('nav-active');}
if(window._structPrev){window._structPrev.classList.add('nav-active');window._structPrev=null;}
window._structLastClose=Date.now();
setTimeout(function(){o.remove();},520);
}
function openStruct(){
if(sw!==null){return;}
if(ov!==null){var _o=ov;closeAll();_o.style.display='none';}
if(tw!==null){var _t=tw;closeTeam();_t.style.display='none';}
var pv=document.querySelector('.buttons button.nav-active');
window._structPrev=(pv&&pv.id!=='structureBtn')?pv:null;
document.querySelectorAll('.buttons button').forEach(function(x){x.classList.remove('nav-active');});
var sb=document.getElementById('structureBtn');if(sb){sb.classList.add('nav-active');}
sw=document.createElement('div');sw.id='structWin';sw.className='upm-win';
sw.style.cssText='left:104px;width:calc(70vw - 104px);padding:0;z-index:2001;border:0;overflow:auto;';
sw.style.padding='16px';sw.innerHTML=STRUCT_DEFS+structListHtml();structBind(sw);structUpd(sw);document.body.appendChild(sw);void sw.offsetWidth;
setTimeout(function(){if(sw){sw.classList.add('on');}},20);
}
document.addEventListener('click',function(e){
if(window.innerWidth<=768){return;}
var t=e.target.closest('#structureBtn');
if(t){var _an=t.querySelectorAll('animateTransform');for(var _i=0;_i<_an.length;_i++){try{_an[_i].beginElement();}catch(_x){}}
e.stopPropagation();e.preventDefault();
if(sw===null){if(Date.now()-(window._structLastClose||0)<560){return;}openStruct();}else{closeStruct();}return;}
if(sw!==null&&e.target.closest('.buttons button')){closeStruct(true);}
},true);
function closeTeam(){
if(tw===null){return;}
var o=tw;tw=null;o.classList.remove('on');
var tb=document.getElementById('teamBtn');if(tb){tb.classList.remove('nav-active');}
if(window._teamPrev){window._teamPrev.classList.add('nav-active');window._teamPrev=null;}
window._teamLastClose=Date.now();
setTimeout(function(){o.remove();},520);
}
function openTeam(){
if(tw!==null){return;}
if(ov!==null){var _o=ov;closeAll();_o.style.display='none';}
var pv=document.querySelector('.buttons button.nav-active');
window._teamPrev=(pv&&pv.id!=='teamBtn')?pv:null;
document.querySelectorAll('.buttons button').forEach(function(x){x.classList.remove('nav-active');});
var tb=document.getElementById('teamBtn');if(tb){tb.classList.add('nav-active');}
tw=document.createElement('div');tw.id='teamWin';tw.className='upm-win';
tw.style.cssText='left:104px;width:420px;padding:0;z-index:2001;border:0;overflow:auto;';tw.innerHTML=teamBdHtml()+teamListHtml();var _tb=tw.querySelector('#teamBd');if(_tb){_tb.style.position='sticky';_tb.style.top='0';_tb.style.zIndex='5';
var _in=document.createElement('input');_in.type='text';_in.placeholder='Поиск...';
_in.style.cssText='position:absolute;top:9px;right:12px;width:150px;height:24px;border:0;border-radius:12px;padding:0 10px;font-size:11px;outline:none;background:rgba(255,255,255,0.92);color:#1f2937;z-index:3;box-sizing:border-box;';
_in.oninput=function(){var q=_in.value.toLowerCase().trim();var L=tw.lastElementChild;if(!L){return;}Array.prototype.forEach.call(L.children,function(w){var t=w.getAttribute('data-s')||'';w.style.display=(!q||t.indexOf(q)>=0)?'':'none';});};
_tb.appendChild(_in);var _bb=tw.querySelector('#teamBdBody');if(_bb){_bb.style.marginTop='14px';}}
document.body.appendChild(tw);void tw.offsetWidth;
setTimeout(function(){if(tw){tw.classList.add('on');}},20);
}
document.addEventListener('click',function(e){
if(window.innerWidth<=768){return;}
var t=e.target.closest('#teamBtn');if(t){var _an=t.querySelectorAll('animateTransform');for(var _i=0;_i<_an.length;_i++){try{_an[_i].beginElement();}catch(_x){}}}
if(t){e.stopPropagation();e.preventDefault();if(tw===null){if(Date.now()-(window._teamLastClose||0)<560){return;}openTeam();}else{closeTeam();}return;}
if(tw!==null&&e.target.closest('.buttons button')&&!e.target.closest('#upmoBtn')){closeTeam();}
},true);
document.addEventListener('click',function(e){
if(window.innerWidth<=768){return;}
var b=e.target.closest('#upmoBtn');
if(b){if(ov===null){openAll();}else if(A.classList.contains('on')){if(B.classList.contains('on')){A.classList.remove('on');}else{closeAll();}}else{A.classList.add('on');}return;}
if(ov&&!window._upmoMapInit&&e.target.closest('.buttons button')){closeAll();}
},true);
})();
